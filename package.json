{
  "name": "dash-web",
  "version": "0.9.0",
  "private": true,
  "engines": {
    "node": "26.x",
    "npm": "11.x || 12.x"
  },
  "scripts": {
    "start": "ng serve -o",
    "start:dev": "ng serve -o -c=dev",
    "build": "ng build --configuration=production",
    "build:bundle-stats": "npm run build -- --stats-json",
    "bundle:analyze": "esbuild-visualizer --metadata ./dist/Dash-Web/stats.json --filename ./bundle-stats/index.html",
    "test": "ng test",
    "test:coverage": "ng test --coverage --watch=false",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:verify": "cypress verify",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "lint:styles": "stylelint \"src/**/*.{css,scss}\"",
    "lint:styles:fix": "npm run lint:styles -- --fix",
    "lint:styles:report": "npm run lint:styles -- --formatter json --output-file ./styleLintReport.json",
    "code:check": "prettier . --check",
    "code:format": "prettier . --write",
    "compodoc:build": "compodoc -p tsconfig.doc.json",
    "compodoc:build-and-serve": "compodoc -p tsconfig.doc.json -s",
    "compodoc:serve": "compodoc -s"
  },
  "dependencies": {
    "@angular/cdk": "22.2.6",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/material": "22.2.6",
    "@angular/material-date-fns-adapter": "22.2.6",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "angular-calendar": "0.32.2",
    "chart.js": "4.6.1",
    "date-fns": "4.4.0",
    "ng2-charts": "11.0.0",
    "ol": "10.11.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.4",
    "@compodoc/compodoc": "2.0.0",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "cypress": "16.2.1",
    "esbuild-visualizer": "0.7.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-cypress": "7.0.3",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "mochawesome": "8.1.1",
    "mochawesome-merge": "5.1.1",
    "mochawesome-report-generator": "6.3.2",
    "prettier": "3.9.10",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
